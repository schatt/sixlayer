+/// Contrast values on the analysis grid, carried through the same
+/// rotation, shear and crops as the ink mask.
+private struct Field {
+    var values: [Double]
+    var width: Int
+    var height: Int
+
+    func rows(_ y0: Int, _ y1: Int) -> Field {
+        let top = max(0, y0), bottom = min(height, max(top, y1))
+        return Field(values: Array(values[(top * width)..<(bottom * width)]), width: width, height: bottom - top)
+    }
+
+    func mean(x0: Int, x1: Int, y0: Int, y1: Int) -> Double {
+        let xa = max(0, x0), xb = min(width, x1), ya = max(0, y0), yb = min(height, y1)
+        guard xb > xa, yb > ya else { return 0 }
+        var total = 0.0
+        for y in ya..<yb {
+            for x in xa..<xb { total += values[y * width + x] }
+        }
+        return total / Double((xb - xa) * (yb - ya))
+    }
+}
