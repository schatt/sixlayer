+/// `rotate` for a contrast field: the same nearest-neighbour mapping.
+private func rotate(_ field: Field, degrees: Double, expand: Bool) -> Field {
+    let radians = degrees * .pi / 180
+    let c = cos(radians), s = sin(radians)
+    let w = Double(field.width), h = Double(field.height)
+    let outW = max(1, expand ? Int((abs(w * c) + abs(h * s)).rounded()) : field.width)
+    let outH = max(1, expand ? Int((abs(w * s) + abs(h * c)).rounded()) : field.height)
+    var out = Field(values: [Double](repeating: 0, count: outW * outH), width: outW, height: outH)
+    let ocx = Double(outW) / 2, ocy = Double(outH) / 2
+    for y in 0..<outH {
+        for x in 0..<outW {
+            let dx = Double(x) + 0.5 - ocx, dy = Double(y) + 0.5 - ocy
+            let sx = Int((c * dx - s * dy + w / 2).rounded(.down))
+            let sy = Int((s * dx + c * dy + h / 2).rounded(.down))
+            if sx >= 0, sy >= 0, sx < field.width, sy < field.height {
+                out.values[y * outW + x] = field.values[sy * field.width + sx]
+            }
+        }
+    }
+    return out
+}
